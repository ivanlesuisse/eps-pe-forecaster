// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String   @id @default(uuid())
  clerkId       String   @unique
  email         String   @unique
  baseCurrency  String   @default("CHF")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  assets        Asset[]
  brokerTokens  BrokerToken[]
  auditLogs     AuditLog[]
}

model BrokerToken {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  broker        String   // "ibkr", "degiro", etc.
  encryptedToken String  // Encrypted OAuth token
  refreshToken  String?  // Optional refresh token (also encrypted)
  expiresAt     DateTime // Token expiration time
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  revoked       Boolean  @default(false)

  @@unique([userId, broker])
}

model AuditLog {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action        String   // "oauth_connected", "portfolio_imported", etc.
  broker        String?
  status        String   // "success", "failure"
  details       String?  // JSON details
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())
}

model Asset {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  name          String
  type          String   // "BANKING", "INVESTMENT", "CRYPTO", etc.
  category      String   // e.g., "Stocks & Funds", "Crypto"
  institution   String?  // e.g., "Revolut", "Binance"
  value         Float    // Current total value in base currency
  quantity      Float    @default(1)
  buyingPrice   Float?   // Average buying price per unit
  currency      String   @default("CHF")
  logo          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  transactions  Transaction[]
}

model Transaction {
  id        String   @id @default(uuid())
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id])
  type      String   // "BUY", "SELL", "DEPOSIT", "WITHDRAWAL"
  amount    Float
  price     Float
  date      DateTime @default(now())
}
